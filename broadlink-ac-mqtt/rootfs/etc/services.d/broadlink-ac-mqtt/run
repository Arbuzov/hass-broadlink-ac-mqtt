#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

## An empty mqtt.host means "ask the Supervisor": it already knows where the
## broker lives and which credentials it issued, so none of it has to be typed
## in twice. A host that is filled in wins, so an external broker still works.
if bashio::config.has_value 'mqtt.host'; then
    bashio::log.info "MQTT broker from the add-on options: $(bashio::config 'mqtt.host')"
else
    bashio::services.available "mqtt" \
        || bashio::exit.nok "mqtt.host is empty and no MQTT service is available"
    export MQTT_SERVICE=true
    MQTT_HOST="$(bashio::services mqtt 'host')"
    MQTT_PORT="$(bashio::services mqtt 'port')"
    MQTT_USER="$(bashio::services mqtt 'username')"
    MQTT_PASS="$(bashio::services mqtt 'password')"
    export MQTT_HOST MQTT_PORT MQTT_USER MQTT_PASS
    bashio::log.info "MQTT broker from the Supervisor: ${MQTT_HOST}:${MQTT_PORT}"
fi

python3 - <<'PY' > /usr/share/broadlink_ac_mqtt/config.yml
import json, os, yaml

config = json.load(open("/data/options.json"))
if os.environ.get("MQTT_SERVICE"):
    ##All four together: half the service and half the options would mean
    ##sending the broker's own credentials to somebody else's host.
    config["mqtt"].update(
        host=os.environ["MQTT_HOST"],
        port=int(os.environ["MQTT_PORT"]),
        user=os.environ["MQTT_USER"],
        passwd=os.environ["MQTT_PASS"],
    )
print(yaml.dump(config))
PY

## Check if debug mode is enabled
DEBUG_FLAG=""
if bashio::config.true 'service.debug'; then
    export BROADLINK_DEBUG=true
    DEBUG_FLAG="-d"
    bashio::log.info "Debug mode is enabled — verbose logging is active"
fi

## Forward log_level / log_level_console from add-on config to monitor.py env vars.
## Ignored by monitor.py if --debug is also passed (debug wins).
if bashio::config.has_value 'service.log_level'; then
    export LOG_LEVEL="$(bashio::config 'service.log_level')"
    bashio::log.info "LOG_LEVEL=${LOG_LEVEL}"
fi
if bashio::config.has_value 'service.log_level_console'; then
    export LOG_LEVEL_CONSOLE="$(bashio::config 'service.log_level_console')"
    bashio::log.info "LOG_LEVEL_CONSOLE=${LOG_LEVEL_CONSOLE}"
fi

## Run your program
python3 /usr/share/broadlink_ac_mqtt/monitor.py ${DEBUG_FLAG}
